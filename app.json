{
  "expo": {
    "name": "RUSH",
    "slug": "rush-app",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "rushapp",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rushapp.hrv",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para medir sua variabilidade da frequência cardíaca (VFC) pelo sensor PPG.",
        "NSMotionUsageDescription": "O acelerômetro é usado para medir a VFC pelo método SCG.",
        "NSHealthShareUsageDescription": "Lemos sua FC em repouso e VFC passiva do Apple Health.",
        "NSHealthUpdateUsageDescription": "Armazenamos seus dados de treino no Apple Health."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.rushapp.hrv",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.rushapp.hrv",
          "enableGooglePay": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0f0f0f",
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada para medir sua variabilidade da frequência cardíaca (VFC)."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e72329",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
