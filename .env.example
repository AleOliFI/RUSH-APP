EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_RC_API_KEY_IOS=your-revenuecat-ios-key
EXPO_PUBLIC_RC_API_KEY_ANDROID=your-revenuecat-android-key

# ── Cakto ────────────────────────────────────────────────────────────────────
# Public checkout links — copy from Cakto dashboard → Offers → Share link
EXPO_PUBLIC_CAKTO_CHECKOUT_MONTHLY=https://pay.cakto.com.br/rush-mensal
EXPO_PUBLIC_CAKTO_CHECKOUT_ANNUAL=https://pay.cakto.com.br/rush-anual

# CAKTO_API_KEY must ONLY be set as a Supabase Edge Function secret.
# Never add it here with the EXPO_PUBLIC_ prefix — it would be bundled in the app.
# Set via: supabase secrets set CAKTO_API_KEY=<your-key>
