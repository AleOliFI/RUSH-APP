EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_RC_API_KEY_IOS=your-revenuecat-ios-key
EXPO_PUBLIC_RC_API_KEY_ANDROID=your-revenuecat-android-key

# ── Stripe ────────────────────────────────────────────────────────────────────
# Publishable key — safe to expose in the app bundle (pk_live_... / pk_test_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key

# Price IDs created in Stripe Dashboard (already created via MCP)
EXPO_PUBLIC_STRIPE_PRICE_MONTHLY=price_1Tc50t3wVAAUEXFEmXmbJr3C
EXPO_PUBLIC_STRIPE_PRICE_ANNUAL=price_1Tc50u3wVAAUEXFE96kZBV49

# The following keys must ONLY live as Supabase Edge Function secrets.
# Never add them with the EXPO_PUBLIC_ prefix — they would be bundled in the app.
#
# supabase secrets set STRIPE_SECRET_KEY=sk_live_...
# supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
