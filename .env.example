# ============================================================
# RUSH PERFORMANCE — Environment Configuration Template
# ============================================================

PORT=3001
JWT_SECRET=your_jwt_secret_key
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_key

# RevenueCat Configuration
VITE_REVENUECAT_PUBLIC_KEY=your_revenuecat_public_key
REVENUECAT_PROJECT_ID=3fe8b180
REVENUECAT_API_KEY=your_revenuecat_api_key

# Frontend API URL
VITE_API_URL=http://localhost:3001

# Web Push (VAPID)
# Gere um par novo com: node -e "console.log(require('web-push').generateVAPIDKeys())"
# A pública é replicada em VITE_ porque o navegador precisa dela para assinar.
# A privada NUNCA pode ser versionada nem exposta ao frontend.
VAPID_SUBJECT=mailto:seu-email@exemplo.com
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
